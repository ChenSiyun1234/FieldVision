    <Pair>
      <key>normal</key>
      <styleUrl>#A</styleUrl>
    </Pair>
    <Pair>
      <key>highlight</key>
      <styleUrl>#B</styleUrl>
    </Pair>
  </StyleMap>
  <Style id="B">
    <BalloonStyle>
      <bgColor>ffccf1ff</bgColor>
